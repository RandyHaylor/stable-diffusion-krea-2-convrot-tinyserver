+// Whether two LoRA selections would load different weights. Order is not
+// meaningful to the loader, so it is normalized away; a difference in path,
+// multiplier or high-noise flag is what matters.
+static bool lora_selection_differs(const sd_lora_t* first, uint32_t first_count,
+                                   const sd_lora_t* second, uint32_t second_count) {
+    if (first_count != second_count) {
+        return true;
+    }
+    auto comparable = [](const sd_lora_t* loras, uint32_t count) {
+        std::vector<std::string> keys;
+        keys.reserve(count);
+        for (uint32_t i = 0; i < count; ++i) {
+            keys.push_back(std::string(loras[i].is_high_noise ? "high_noise|" : "|")
+                           + std::to_string(loras[i].multiplier) + "|" + SAFE_STR(loras[i].path));
+        }
+        std::sort(keys.begin(), keys.end());
+        return keys;
+    };
+    return comparable(first, first_count) != comparable(second, second_count);
+}
