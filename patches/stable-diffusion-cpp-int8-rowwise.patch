+// Scale the hidden states of each vision image's own tokens, leaving every other
+// token alone. Deliberately not routed through apply_token_weights: that restores
+// the global mean afterwards, which with hundreds of image tokens would rescale the
+// text tokens in the opposite direction and half-undo the effect asked for.
+//
+// `image_embeds` pairs each image's first token index with its embedding, so the
+// spans come from whatever the conditioner actually assembled rather than from a
+// second guess at the image order.
+static inline sd::Tensor<float> scale_vlm_image_token_hidden_states(
+    sd::Tensor<float> hidden_states,
+    const std::vector<std::pair<int, sd::Tensor<float>>>& image_embeds,
+    const std::vector<float>& vlm_image_token_weights) {
+    if (hidden_states.empty() || image_embeds.empty() || vlm_image_token_weights.empty()) {
+        return hidden_states;
+    }
+
+    bool all_one = true;
+    for (float weight : vlm_image_token_weights) {
+        if (weight != 1.0f) {
+            all_one = false;
+            break;
+        }
+    }
+    if (all_one) {
+        return hidden_states;
+    }
+
+    if (hidden_states.dim() == 1) {
+        hidden_states.unsqueeze_(1);
+    }
+    const int64_t token_count = hidden_states.shape()[1];
+
+    if (vlm_image_token_weights.size() != image_embeds.size()) {
+        LOG_WARN("got %zu vlm_image_token_weight value(s) for %zu vision image(s); "
+                 "images without one are left unweighted",
+                 vlm_image_token_weights.size(),
+                 image_embeds.size());
+    }
+
+    std::vector<float> per_token_weights(static_cast<size_t>(token_count), 1.0f);
+    for (size_t image_index = 0; image_index < image_embeds.size(); ++image_index) {
+        if (image_index >= vlm_image_token_weights.size()) {
+            break;
+        }
+        const float weight = vlm_image_token_weights[image_index];
+        if (weight == 1.0f) {
+            continue;
+        }
+        const int64_t first_token = image_embeds[image_index].first;
+        const int64_t span        = image_embeds[image_index].second.shape()[1];
+        if (first_token < 0 || span <= 0 || first_token + span > token_count) {
+            LOG_WARN("vision image %zu spans tokens [%ld,%ld) outside the %ld token prompt; not weighted",
+                     image_index + 1,
+                     (long)first_token,
+                     (long)(first_token + span),
+                     (long)token_count);
+            continue;
+        }
+        for (int64_t token = first_token; token < first_token + span; ++token) {
+            per_token_weights[static_cast<size_t>(token)] = weight;
+        }
+        LOG_INFO("vlm_image_token_weight %.3g on vision image %zu (%ld token(s) from index %ld)",
+                 weight,
+                 image_index + 1,
+                 (long)span,
+                 (long)first_token);
+    }
+
+    auto weight_row = sd::Tensor<float>::from_vector(per_token_weights);
+    weight_row.reshape_({1, token_count});
+    hidden_states *= weight_row;
+
+    return hidden_states;
+}
