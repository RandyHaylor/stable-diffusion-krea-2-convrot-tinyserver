+// Everything the parked callback needs; the job holds the reply, the manager
+// holds the lock and the condition variable it waits on.
+struct HiresStageInputWait {
+    AsyncJobManager* manager = nullptr;
+    AsyncGenerationJob* job  = nullptr;
+};
+
+// Runs on the worker thread between the two passes, while the first stage's
+// latent is still held by generate_image. Publishes the decoded first stage,
+// then blocks until the caller replies or the job is cancelled.
+static bool wait_for_hires_stage_input(const sd_image_t* first_stage_image,
+                                       sd_hires_stage_input_t* input,
+                                       void* user_data) {
+    auto* wait = static_cast<HiresStageInputWait*>(user_data);
+    if (wait == nullptr || wait->manager == nullptr || wait->job == nullptr) {
+        return false;
+    }
+    AsyncJobManager& manager = *wait->manager;
+    AsyncGenerationJob& job  = *wait->job;
+
+    std::string first_stage_image_b64;
+    if (first_stage_image != nullptr && first_stage_image->data != nullptr) {
+        auto image_bytes = encode_image_to_vector(EncodedImageFormat::PNG,
+                                                  first_stage_image->data,
+                                                  static_cast<int>(first_stage_image->width),
+                                                  static_cast<int>(first_stage_image->height),
+                                                  static_cast<int>(first_stage_image->channel),
+                                                  "");
+        first_stage_image_b64 = base64_encode(image_bytes);
+    }
+
+    std::unique_lock<std::mutex> lock(manager.mutex);
+    job.first_stage_image_b64 = std::move(first_stage_image_b64);
+    job.status                = AsyncJobStatus::AwaitingHiresInput;
+    manager.cv.notify_all();
+    manager.cv.wait(lock, [&] {
+        return job.hires_input_supplied || job.status == AsyncJobStatus::Cancelled || manager.stop;
+    });
+    if (job.status == AsyncJobStatus::Cancelled || manager.stop) {
+        return false;
+    }
+    job.status = AsyncJobStatus::Generating;
+
+    job.hires_vlm_image_views.clear();
+    job.hires_vlm_image_views.reserve(job.hires_vlm_images.size());
+    for (auto& image : job.hires_vlm_images) {
+        job.hires_vlm_image_views.push_back(image.get());
+    }
+    input->prompt           = job.hires_prompt.empty() ? nullptr : job.hires_prompt.c_str();
+    input->negative_prompt  = job.hires_negative_prompt.empty() ? nullptr
+                                                                : job.hires_negative_prompt.c_str();
+    input->vlm_images       = job.hires_vlm_image_views.empty() ? nullptr
+                                                                : job.hires_vlm_image_views.data();
+    input->vlm_images_count = static_cast<int>(job.hires_vlm_image_views.size());
+
+    job.hires_lora_views.clear();
+    job.hires_lora_views.reserve(job.hires_lora_paths.size());
+    for (size_t i = 0; i < job.hires_lora_paths.size(); ++i) {
+        sd_lora_t lora{};
+        lora.is_high_noise = false;
+        lora.multiplier    = i < job.hires_lora_multipliers.size()
+                                 ? job.hires_lora_multipliers[i]
+                                 : 1.0f;
+        lora.path          = job.hires_lora_paths[i].c_str();
+        job.hires_lora_views.push_back(lora);
+    }
+    input->applies_own_loras = job.hires_applies_own_loras;
+    input->loras      = job.hires_lora_views.empty() ? nullptr : job.hires_lora_views.data();
+    input->lora_count = static_cast<int>(job.hires_lora_views.size());
+    return true;
+}
+
+bool supply_hires_stage_input(AsyncJobManager& manager,
+                              AsyncGenerationJob& job,
+                              const std::string& prompt,
+                              const std::string& negative_prompt,
+                              std::vector<SDImageOwner> vlm_images,
+                              bool applies_own_loras,
+                              std::vector<std::string> lora_paths,
+                              std::vector<float> lora_multipliers) {
+    if (job.status != AsyncJobStatus::AwaitingHiresInput) {
+        return false;
+    }
+    job.hires_prompt              = prompt;
+    job.hires_negative_prompt     = negative_prompt;
+    job.hires_vlm_images          = std::move(vlm_images);
+    job.hires_applies_own_loras   = applies_own_loras;
+    job.hires_lora_paths       = std::move(lora_paths);
+    job.hires_lora_multipliers = std::move(lora_multipliers);
+    job.hires_input_supplied   = true;
+    manager.cv.notify_all();
+    return true;
+}
