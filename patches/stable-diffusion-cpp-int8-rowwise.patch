+// Re-runs the conditioning for the hires pass when the caller gave it text or
+// vision of its own. The latents are only read, never replaced, so the refinement
+// still continues from the first stage's latent instead of a re-encoded image.
+static bool re_encode_hires_conditioning(sd_ctx_t* sd_ctx,
+                                         const sd_img_gen_params_t* sd_img_gen_params,
+                                         GenerationRequest* request,
+                                         SamplePlan* plan,
+                                         ImageGenerationLatents* latents,
+                                         const RefImageParams& ref_image_params,
+                                         const sd_hires_stage_input_t& stage_input,
+                                         ImageGenerationEmbeds* embeds) {
+    const bool has_prompt = stage_input.prompt != nullptr && strlen(stage_input.prompt) > 0;
+    const bool has_negative_prompt =
+        stage_input.negative_prompt != nullptr && strlen(stage_input.negative_prompt) > 0;
+    const bool has_vlm_images = stage_input.vlm_images_count > 0 && stage_input.vlm_images != nullptr;
+    if (!has_prompt && !has_negative_prompt && !has_vlm_images) {
+        return true;
+    }
+
+    const std::string first_stage_prompt          = request->prompt;
+    const std::string first_stage_negative_prompt = request->negative_prompt;
+    std::vector<sd::Tensor<float>> first_stage_vlm_images = std::move(latents->vlm_images);
+
+    if (has_prompt) {
+        request->prompt = stage_input.prompt;
+    }
+    if (has_negative_prompt) {
+        request->negative_prompt = stage_input.negative_prompt;
+    }
+    latents->vlm_images.clear();
+    if (has_vlm_images) {
+        const int image_channels = sd_ctx->sd->get_image_channels();
+        for (int i = 0; i < stage_input.vlm_images_count; i++) {
+            latents->vlm_images.push_back(
+                ensure_image_tensor_channels(sd_image_to_tensor(stage_input.vlm_images[i]), image_channels));
+        }
+    }
+
+    LOG_INFO("hires fix: re-encoding conditioning for the hires pass");
+    auto hires_embeds = prepare_image_generation_embeds(sd_ctx, sd_img_gen_params, request,
+                                                        plan, latents, ref_image_params);
+
+    request->prompt          = first_stage_prompt;
+    request->negative_prompt = first_stage_negative_prompt;
+    latents->vlm_images      = std::move(first_stage_vlm_images);
+
+    if (!hires_embeds.has_value()) {
+        LOG_ERROR("failed to encode the hires conditioning");
+        return false;
+    }
+    *embeds = std::move(hires_embeds.value());
+    return true;
+}
